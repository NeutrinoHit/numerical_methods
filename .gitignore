# Quarto
.quarto/
/_site/
/_book/
*_files/
**/*.quarto_ipynb*
/_freeze/
.ipynb_checkpoints/
# Notebooks exported from notebooks/*.qmd at render time
/ru/slides/notebooks/*.ipynb
/en/slides/notebooks/*.ipynb
# Previews of unpublished lectures rendered next to their sources
/*/slides/planned/*.html
/*/book/planned/*.html
# LaTeX source kept by keep-tex during the PDF build
/*/book/numerical-methods.tex

# Local build/cache
.make-tmp/
Makefile.local
__pycache__/
*.pyc
*.aux
*.log
*.out
*.toc
*.synctex.gz
.venv/

# Generated figures (keep the directory)
shared/figures/generated/*
!shared/figures/generated/.gitkeep

.DS_Store

# Local working files
/.work/

/.quarto/
**/*.quarto_ipynb
